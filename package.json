{
  "name": "dsh-gamer",
  "version": "0.2.0",
  "description": "DSH bundle + 游戏玩家 preset: play on a dsh-gaming-platform instance.",
  "repository": "github:amphilagus/dsh-gamer",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "preset",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
